{
  "name": "agentic-engineering-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Aufgabenstellung, Starter und Referenz für einen vollständigen agentischen Feature-Zyklus",
  "engines": { "node": ">=22" },
  "scripts": {
    "start:starter": "node starter/src/server.js",
    "start:reference": "node reference/src/server.js",
    "test": "node --test starter/test/*.test.js reference/test/*.test.js",
    "test:starter": "node --test starter/test/*.test.js",
    "test:reference": "node --test reference/test/*.test.js",
    "tool:check": "node tools/run-tests.js",
    "demo:regression": "node tools/demo-regression.js",
    "verify": "node tools/verify.js"
  },
  "dependencies": { "express": "5.1.0" },
  "devDependencies": { "supertest": "7.1.4" }
}
